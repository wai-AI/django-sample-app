#!/bin/bash
set -eu
export DEBIAN_FRONTEND=noninteractive
export ANSIBLE_COLLECTIONS_PATH=/opt/ansible-collections
export ANSIBLE_NOCOLOR=1
export GIT_TERMINAL_PROMPT=0

# State Manager may retry an association. Avoid overlapping package installs
# and deployments on the same host.
exec 9>/var/lock/healthchecks-deployment.lock
flock -w 3600 9

apt-get -o DPkg::Lock::Timeout=300 update
apt-get -o DPkg::Lock::Timeout=300 install -y python3-venv python3-pip git acl curl
if [ ! -x /opt/ansible-venv/bin/python ]; then
  python3 -m venv /opt/ansible-venv
fi
/opt/ansible-venv/bin/pip install 'ansible-core>=2.19,<2.20' 'boto3>=1.35,<2' 'botocore>=1.35,<2'

repository=$(printf '%s' '${repository_b64}' | base64 --decode)
if [ ! -d /opt/deployment/.git ]; then
  git clone "$repository" /opt/deployment
fi
git -C /opt/deployment fetch origin '${commit}'
git -C /opt/deployment checkout --detach '${commit}'

/opt/ansible-venv/bin/ansible-galaxy collection install \
  -r /opt/deployment/ansible/requirements.yml -p /opt/ansible-collections

# Only addresses, parameter NAMES and deployment options are written here.
# Secret values are fetched on the instance by the Ansible playbook.
umask 077
printf '%s' '${variables_b64}' | base64 --decode > /opt/deployment-vars.json
cd /opt/deployment

%{ if stage == "db" ~}
/opt/ansible-venv/bin/ansible-playbook -i localhost, ansible/db.yml -e @/opt/deployment-vars.json
systemctl is-active postgresql
runuser -u postgres -- psql -v ON_ERROR_STOP=1 -d healthchecks -c 'SELECT current_database();'
%{ else ~}
/opt/ansible-venv/bin/ansible-playbook -i localhost, ansible/webservers.yml -e @/opt/deployment-vars.json
/opt/ansible-venv/bin/ansible-playbook -i localhost, ansible/deploy.yml -e @/opt/deployment-vars.json
systemctl is-active healthchecks
curl --fail --silent --show-error --retry 20 --retry-connrefused --retry-delay 3 \
  --connect-timeout 5 --max-time 15 http://127.0.0.1/api/v3/status/
%{ endif ~}
